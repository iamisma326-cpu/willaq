  "_meta": {
    "descripcion": "Catálogo piloto WILLAQ. Población e infraestructura son ESTIMACIONES de referencia para la demo; reemplazables con el importador CSV (INEI/MINEDU/MINSA) sin tocar código.",
    "version": "1.1",
    "actualizado": "2026-11-06",
    "fuente_exposicion": "estimacion_ratio_poblacional",
    "nota": "susc_* = susceptibilidad estática 0-1 calibrada con inventario histórico 2000-2025. No es un modelo hidrológico.",
    "ubigeo": {
      "descripcion": "Código ubigeo de 6 dígitos (INEI: departamento + provincia + distrito) de cada distrito. Permite resolver por clave oficial los CSV de INEI/MINEDU/MINSA.",
      "fuente": "INEI / RENIEC — tabla de ubigeos del Perú (departamento, provincia, distrito). Verificado distrito por distrito contra el catálogo, contrastando también coordenadas y altitud.",
      "verificado_en": "2026-11-06",
      "nota": "Las coordenadas del catálogo apuntan al casco urbano (localidad); la tabla INEI usa el centroide del distrito. La diferencia llega a ~32 km en distritos extensos (San Mateo, Huarochirí: 426 km²). Para consultas de clima, la localidad es la referencia correcta; para estadísticas de distrito, el centroide lo es. Ambas son defendibles: lo que no se hace es mezclarlas sin decirlo."
    },
    "overlay_exposicion": {
      "descripcion": "Los valores oficiales de población, viviendas, escuelas y centros de salud NO viven aquí: viven en data/exposicion_oficial.json, que genera scripts/importar_exposicion.php.",
      "motivo": "Borrar el overlay devuelve el sistema a la estimación actual. Así el catálogo base nunca se pierde y el jurado puede ver el diff completo.",
      "importador": "php scripts/importar_exposicion.php --aplicar"
    }
  },
