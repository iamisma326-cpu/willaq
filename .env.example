# ============================================================================
# WILLAQ — Variables de entorno de ejemplo
# Copiar a `.env` y ajustar. NUNCA subir el `.env` real a un repositorio.
# ============================================================================

# --- Base de datos (opcional) ------------------------------------------------
# Si estas variables no existen o el servidor no responde, WILLAQ usa archivos
# JSON en data/ y las cuentas de demostración. La feria funciona sin base.
#
# Motor: pgsql (PostgreSQL, el recomendado) o mysql (alternativa heredada).
DB_DRIVER=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=willaq_db
DB_USER=willaq
DB_PASS=
# SSL: disable|allow|prefer|require|verify-ca|verify-full
# Local: prefer. AWS RDS / Google Cloud SQL: require.
DB_SSLMODE=prefer
# Segundos de espera al conectar antes de caer al modo JSON.
DB_CONNEC_TIMEOUT=5

# --- Modo feria --------------------------------------------------------------
# 1 = lee data/snapshots/riesgo_nacional_{24,48,72}h.json (un archivo por
#     ventana) y muestra la franja de aviso en pantalla.
# 0 = consulta Open-Meteo en vivo con caché de 1 hora.
WILLAQ_MODO_OFFLINE=0

# --- Zona horaria ------------------------------------------------------------
WILLAQ_TZ=America/Lima

# --- Límites de red ----------------------------------------------------------
# Tiempo máximo por petición a Open-Meteo (segundos).
WILLAQ_HTTP_TIMEOUT=12
# Reintentos ante error de red.
WILLAQ_HTTP_REINTENTOS=2

# --- Demostración ------------------------------------------------------------
# Permite acelerar la carga inicial usando el snapshot si la API tarda.
WILLAQ_PERMITIR_SNAPSHOT_RAPIDO=1

# --- Actualización automática ------------------------------------------------
# Token que protege el endpoint /?action=cron_actualizar. Un servicio externo
# (cron-job.org, GitHub Actions, etc.) lo llama cada 6 h para regenerar los
# snapshots de riesgo. Déjelo vacío para deshabilitar el endpoint.
WILLAQ_CRON_TOKEN=
